---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import Comments from '../components/Comments.astro'

type Props = CollectionEntry<"blog">["data"] & {
	Content: any;
};

const { title, description, pubDate, updatedDate, heroImage, Content } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} og_type="article" />
	</head>

	<body class="flex flex-col min-h-screen">
		<Header />
		<main class="flex-grow max-w-6xl mx-auto w-full px-4 md:px-6 py-8 md:py-12">
			<article class="prose dark:prose-invert max-w-none">
				{
					heroImage && (
						<div class="mb-8 rounded-lg overflow-hidden">
							<Image
								width={1020}
								height={510}
								src={heroImage}
								alt=""
								loading="lazy"
								class="w-full h-auto"
							/>
						</div>
					)
				}
				<div class="mb-12 text-center">
					<h1 class="text-xl md:text-2xl font-bold text-[var(--text-primary)] mb-12">
						{title}
					</h1>
					<hr class="border-t border-[var(--border)] mb-12" />
				</div>
				<div class="flex flex-col gap-2 mb-6">
					{
						pubDate ? (
							<div class="text-sm text-[var(--text-secondary)]">
								Published: <FormattedDate date={pubDate} />
							</div>
						) : null
					}
					{
						updatedDate ? (
							<div class="text-sm text-[var(--text-secondary)]">
								Last updated: <FormattedDate date={updatedDate} />
							</div>
						) : null
					}
				</div>
				<div class="text-[var(--text-secondary)] leading-relaxed">
					<Content components={{ Icon }} />
				</div>
			</article>
			<Comments/>
		</main>
		<Footer />
	</body>
</html>
