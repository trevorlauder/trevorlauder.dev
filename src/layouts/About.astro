---
import { Image } from "astro:assets";
import Prose from "../components/Prose.astro";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import profileImage from "../assets/profile.webp";
import ogImage from "../assets/og.png";

const content = Astro.props.content || Astro.props.frontmatter || {};
const title = content.title;
const description = content.description;

const heroImage = profileImage;
const heroImageWidth = 180;
const heroImageHeight = 180;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={ogImage} />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-grow max-w-6xl mx-auto w-full px-4 md:px-6 py-8 md:py-12">
      <div>
        <div class="mb-12 text-center">
          <h1 class="text-3xl md:text-4xl font-bold text-[var(--text-primary)] mb-12">{title}</h1>
          <hr class="border-t border-[var(--border)] mb-12" />
        </div>
        {
          heroImage && (
            <div class="flex justify-center mb-12">
              <a
                href="https://www.linkedin.com/in/trevor-lauder"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Trevor Lauder on LinkedIn"
                class="profile-hover rounded-full overflow-hidden"
              >
                <Image
                  src={heroImage}
                  width={heroImageWidth}
                  height={heroImageHeight}
                  alt="Profile picture"
                  loading="lazy"
                  class="rounded-full"
                />
              </a>
            </div>
          )
        }
        <div class="prose dark:prose-invert max-w-none">
          <Prose>
            <slot />
          </Prose>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
