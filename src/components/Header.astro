---
import { SITE_TITLE } from "../consts";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import profile from "../assets/profile.webp";
import HeaderLink from "./HeaderLink.astro";
---

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:bg-[var(--surface)] focus:text-[var(--text-primary)] focus:px-4 focus:py-2 focus:rounded focus:z-50">
  Skip to content
</a>

<header id="site-header" class="res-nav sticky top-0 z-10 px-6 md:px-12 py-5 border-b border-[var(--border-subtle)]">
  <div class="flex items-center gap-7">
    <a href="/" class="flex items-center gap-2.5 no-underline text-[var(--text-primary)]">
      <Image src={profile} alt="" width="28" height="28" class="w-7 h-7 rounded-full object-cover" />
      <span class="text-[15px] font-semibold tracking-[-0.005em]">{SITE_TITLE}</span>
    </a>

    <nav class="ml-auto hidden md:flex items-center gap-5 text-sm">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/blog/page/1">Writing</HeaderLink>
      <HeaderLink href="/projects">Projects</HeaderLink>
      <HeaderLink href="/photography">Photography</HeaderLink>
      <HeaderLink href="/tags">Tags</HeaderLink>
      <HeaderLink href="/categories">Categories</HeaderLink>
      <HeaderLink href="/about">About Me</HeaderLink>
      <a href="/rss.xml" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-sm transition-colors py-1.5">RSS</a>
    </nav>

    <button
      id="nav-toggle"
      type="button"
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label="Open menu"
      class="ml-auto md:hidden inline-flex items-center justify-center w-10 h-10 rounded text-[var(--text-primary)] hover:bg-[var(--surface)] transition-colors"
    >
      <Icon name="fa7-solid:bars" class="w-5 h-5 nav-icon-open" />
      <Icon name="fa7-solid:xmark" class="w-5 h-5 nav-icon-close hidden" />
    </button>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Mobile"
    class="md:hidden hidden flex-col gap-1 mt-4 pb-1 text-sm"
  >
    <HeaderLink href="/">Home</HeaderLink>
    <HeaderLink href="/blog/page/1">Writing</HeaderLink>
    <HeaderLink href="/projects">Projects</HeaderLink>
    <HeaderLink href="/photography">Photography</HeaderLink>
    <HeaderLink href="/tags">Tags</HeaderLink>
    <HeaderLink href="/categories">Categories</HeaderLink>
    <HeaderLink href="/about">About Me</HeaderLink>
    <a href="/rss.xml" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-sm transition-colors py-1.5">RSS</a>
  </nav>
</header>

<style>
  .res-nav { background: color-mix(in srgb, var(--background) 88%, transparent); backdrop-filter: blur(10px); }
  #mobile-nav[data-open="true"] { display: flex; }
</style>

<script>
  function setupMobileNav(): void {
    const btn = document.getElementById("nav-toggle");
    const panel = document.getElementById("mobile-nav");
    if (!btn || !panel) return;

    const open = btn.querySelector(".nav-icon-open");
    const close = btn.querySelector(".nav-icon-close");

    function setOpen(isOpen: boolean): void {
      if (!btn || !panel) return;
      btn.setAttribute("aria-expanded", String(isOpen));
      btn.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
      panel.dataset.open = isOpen ? "true" : "false";
      open?.classList.toggle("hidden", isOpen);
      close?.classList.toggle("hidden", !isOpen);
    }

    btn.addEventListener("click", () => {
      setOpen(btn.getAttribute("aria-expanded") !== "true");
    });

    panel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });
  }

  document.addEventListener("astro:page-load", setupMobileNav);
</script>
