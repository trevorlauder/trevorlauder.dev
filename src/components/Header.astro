---
import { SITE_TITLE } from "../consts";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import profile from "../assets/profile.webp";
import HeaderLink from "./HeaderLink.astro";
---

<header class="bg-[var(--surface)] shadow-md dark:shadow-lg border-b border-[var(--border)]">
  <nav class="flex items-center justify-between px-4 md:px-6 py-2 relative">
    <div class="flex items-center gap-3">
      <Image src={profile} alt="Profile picture" class="w-10 h-10 rounded-full object-cover" />
      <h2 class="m-0 text-lg font-bold text-[var(--text-primary)]">
        {SITE_TITLE}
      </h2>
    </div>
    <button
      id="mobile-menu-button"
      class="md:hidden p-2 text-[var(--text-primary)] hover:text-[var(--accent)] relative z-50"
      aria-label="Toggle navigation menu"
      type="button"
      onclick="document.getElementById('nav-links').classList.toggle('hidden')"
    >
      <Icon name="fa7-solid:bars" width="24" height="24" />
    </button>
    <div
      id="nav-links"
      class="hidden md:flex md:flex-row absolute md:relative top-12 md:top-auto left-0 md:left-auto right-0 md:right-auto flex-col bg-[var(--surface)] md:bg-transparent w-full md:w-auto p-4 md:p-0 md:gap-4 border-b md:border-b-0 border-[var(--border)] z-40"
    >
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/blog/page/1">Blog</HeaderLink>
      <HeaderLink href="/tags">Tags</HeaderLink>
      <HeaderLink href="/categories">Categories</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
      <HeaderLink href="/privacy">Privacy</HeaderLink>
      <HeaderLink href="/404">404</HeaderLink>
    </div>
    <div class="social-links hidden md:flex gap-3">
      <a
        href="https://www.linkedin.com/in/trevor-lauder"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
      >
        <span class="sr-only">Connect with Trevor on LinkedIn</span>
        <Icon name="fa7-brands:linkedin" width="24" height="24" />
      </a>
      <a
        href="https://github.com/trevorlauder"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
      >
        <span class="sr-only">Go to Trevor's GitHub repo</span>
        <Icon name="fa7-brands:github" width="24" height="24" />
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  // Close menu when links are clicked
  document.querySelectorAll('#nav-links a').forEach(link => {
    link.addEventListener('click', () => {
      document.getElementById('nav-links')?.classList.add('hidden');
    });
  });
</script>

<style>
  @media (max-width: 768px) {
    #nav-links a {
      display: block;
      width: 100%;
      border-bottom: 1px solid var(--border);
    }
  }
</style>
