---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a
	href={href}
	class:list={[
		'inline-block px-3 py-2 text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors border-b-4 border-transparent hover:border-[var(--accent)] dark:hover:border-[var(--accent)]',
		{ 'font-bold border-b-[var(--accent)] text-[var(--accent)]': isActive },
		className
	]}
	{...props}
>
	<slot />
</a>
