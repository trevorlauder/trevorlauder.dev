---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import { getPostSlug } from "../utils/blog";

interface Props {
  posts: CollectionEntry<"blog">[];
  emptyMessage?: string;
  groupByYear?: boolean;
}

const { posts, emptyMessage = "No posts found.", groupByYear = false } = Astro.props;

// Group posts by year (descending) if requested.
type Group = { year: string; posts: CollectionEntry<"blog">[] };
const groups: Group[] = [];
if (groupByYear) {
  const byYear = new Map<string, CollectionEntry<"blog">[]>();
  for (const p of posts) {
    const y = p.data.pubDate ? String(p.data.pubDate.getFullYear()) : "-";
    if (!byYear.has(y)) byYear.set(y, []);
    byYear.get(y)!.push(p);
  }
  for (const [year, list] of Array.from(byYear.entries()).sort(
    (a, b) => b[0].localeCompare(a[0]),
  )) {
    groups.push({ year, posts: list });
  }
}
---

{
  posts.length === 0 ? (
    <p class="text-[var(--text-muted)] italic">{emptyMessage}</p>
  ) : groupByYear ? (
    <div class="flex flex-col">
      {groups.map((g) => (
        <>
          <div class="flex items-baseline gap-4 mt-8 first:mt-0 mb-3">
            <span class="font-serif text-[22px] tracking-[-0.01em] text-[var(--text-muted)]">{g.year}</span>
            <span class="flex-1 h-px bg-[var(--border-subtle)]"></span>
          </div>
          <div class="flex flex-col">
            {g.posts.map((post) => (
              <a
                href={`/blog/${getPostSlug(post.id)}/`}
                class="res-post group grid grid-cols-[100px_1fr] md:grid-cols-[100px_1fr_auto] gap-5 md:gap-7 items-baseline py-5 border-b border-[var(--border-faint)] last:border-b-0 no-underline transition-[padding] duration-200 hover:pl-1.5"
              >
                <time class="font-mono text-[13px] text-[var(--text-muted)] tabular-nums whitespace-nowrap">
                  <FormattedDate date={post.data.pubDate!} />
                </time>
                <div>
                  <h3 class="font-serif text-[19px] font-normal tracking-[-0.01em] text-[var(--text-primary)] leading-[1.35] m-0 transition-colors group-hover:text-[var(--accent)]">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="text-sm text-[var(--text-secondary)] leading-[1.5] mt-1 max-w-[58ch]">
                      {post.data.description}
                    </p>
                  )}
                </div>
                {post.data.categories && post.data.categories.length > 0 && (
                  <div class="hidden md:block text-[11px] uppercase tracking-[0.08em] font-medium text-[var(--text-muted)] whitespace-nowrap">
                    {post.data.categories.join(" · ")}
                  </div>
                )}
              </a>
            ))}
          </div>
        </>
      ))}
    </div>
  ) : (
    <div class="flex flex-col">
      {posts.map((post) => (
        <a
          href={`/blog/${getPostSlug(post.id)}/`}
          class="res-post group grid grid-cols-[100px_1fr] md:grid-cols-[100px_1fr_auto] gap-5 md:gap-7 items-baseline py-5 border-b border-[var(--border-faint)] last:border-b-0 no-underline transition-[padding] duration-200 hover:pl-1.5"
        >
          <time class="font-mono text-[13px] text-[var(--text-muted)] tabular-nums whitespace-nowrap">
            <FormattedDate date={post.data.pubDate!} />
          </time>
          <div>
            <h3 class="font-serif text-[19px] font-normal tracking-[-0.01em] text-[var(--text-primary)] leading-[1.35] m-0 transition-colors group-hover:text-[var(--accent)]">
              {post.data.title}
            </h3>
            {post.data.description && (
              <p class="text-sm text-[var(--text-secondary)] leading-[1.5] mt-1 max-w-[58ch]">
                {post.data.description}
              </p>
            )}
          </div>
          {post.data.categories && post.data.categories.length > 0 && (
            <div class="hidden md:block text-[11px] uppercase tracking-[0.08em] font-medium text-[var(--text-muted)] whitespace-nowrap">
              {post.data.categories.join(" · ")}
            </div>
          )}
        </a>
      ))}
    </div>
  )
}
