---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Lightbox from "../components/Lightbox.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import {
  enrichPostsWithDates,
  getPostSlug,
  sortPostsByDate,
} from "../utils/blog";

import img1 from "../assets/gallery/DSC_0041-Max_Value.webp";
import img2 from "../assets/gallery/DSC_0047-Max_Value.webp";
import img3 from "../assets/gallery/DSC_0053-Min_Horizon_Noise.webp";
import img4 from "../assets/gallery/DSC_5856.webp";

const homeStrip = [
  { full: img1, caption: "Milky Way @ Dry Island Buffalo Jump Provincial Park" },
  { full: img2, caption: "Milky Way @ Dry Island Buffalo Jump Provincial Park" },
  { full: img3, caption: "Milky Way w/ Andromeda @ Dry Island Buffalo Jump Provincial Park" },
  { full: img4, caption: "Comet C/2020 F3 (NEOWISE)" },
];

const allPosts = await getCollection("blog");
const recentPosts = sortPostsByDate(enrichPostsWithDates(allPosts))
  .filter((p) => p.data.pubDate)
  .slice(0, 5);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script src="../scripts/quotes.ts"></script>
  </head>
  <body class="min-h-screen">
    <Header />
    <main id="main" class="max-w-[1080px] mx-auto px-6 md:px-12 pt-[72px] pb-24">
      <section class="pb-14 border-b border-[var(--border-subtle)]">
        <p class="font-serif text-[clamp(44px,6vw,68px)] leading-[1.02] tracking-[-0.028em] text-[var(--text-primary)] m-0 mb-4 text-balance">Trevor Lauder</p>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 text-[14px] text-[var(--text-secondary)] mb-7">
          <span class="inline-flex items-center gap-2">
            <Icon name="fa7-solid:briefcase" class="w-3.5 h-3.5 text-[var(--text-muted)]" />
            Senior Site Reliability Engineer at <a href="https://www.getjobber.com/" class="text-[var(--text-secondary)] no-underline hover:text-[var(--accent)]">Jobber</a>
          </span>
          <span class="inline-flex items-center gap-2">
            <Icon name="fa7-solid:location-dot" class="w-3.5 h-3.5 text-[var(--text-muted)]" />
            Sylvan Lake, AB
          </span>
        </div>
        <h1 id="quote" class="font-serif font-normal italic text-[clamp(26px,3.2vw,36px)] leading-[1.25] tracking-[-0.015em] text-[var(--accent)] m-0 text-balance min-h-[1.25em]"></h1>
      </section>

      <section class="py-14 border-b border-[var(--border-subtle)]">
        <div class="flex items-baseline justify-between mb-7">
          <span class="text-xs font-medium uppercase tracking-[0.08em] text-[var(--text-muted)]">Writing</span>
          <a href="/blog/page/1" class="text-[13px] text-[var(--text-secondary)] no-underline hover:text-[var(--accent)]">All posts &rarr;</a>
        </div>
        <div class="flex flex-col">
          {recentPosts.map((post) => (
            <a
              href={`/blog/${getPostSlug(post.id)}/`}
              class="group grid grid-cols-[100px_1fr] md:grid-cols-[100px_1fr_auto] gap-5 md:gap-7 items-baseline py-5 border-b border-[var(--border-faint)] last:border-b-0 no-underline transition-[padding] duration-200 hover:pl-1.5"
            >
              <time class="font-mono text-[13px] text-[var(--text-muted)] tabular-nums whitespace-nowrap">
                <FormattedDate date={post.data.pubDate!} />
              </time>
              <div>
                <h3 class="font-serif text-[19px] font-normal tracking-[-0.01em] text-[var(--text-primary)] leading-[1.35] m-0 transition-colors group-hover:text-[var(--accent)]">
                  {post.data.title}
                </h3>
                {post.data.description && (
                  <p class="text-sm text-[var(--text-secondary)] leading-[1.5] mt-1 max-w-[58ch]">
                    {post.data.description}
                  </p>
                )}
              </div>
              {post.data.categories && post.data.categories.length > 0 && (
                <div class="hidden md:block text-[11px] uppercase tracking-[0.08em] font-medium text-[var(--text-muted)] whitespace-nowrap">
                  {post.data.categories.join(" · ")}
                </div>
              )}
            </a>
          ))}
        </div>
      </section>

      <section class="py-14">
        <div class="flex items-baseline justify-between mb-7">
          <span class="text-xs font-medium uppercase tracking-[0.08em] text-[var(--text-muted)]">Photography</span>
          <a href="/photography" class="text-[13px] text-[var(--text-secondary)] no-underline hover:text-[var(--accent)]">Full gallery &rarr;</a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
          {homeStrip.map((image, index) => (
            <button
              onclick={`window.openGalleryLightbox(${index})`}
              class="relative overflow-hidden group cursor-pointer text-left block w-full p-0 bg-transparent border-0 aspect-square"
            >
              <Image
                src={image.full}
                alt=""
                widths={[200, 300, 400, 500]}
                sizes="(max-width: 768px) 50vw, 25vw"
                quality={65}
                loading={index < 2 ? "eager" : "lazy"}
                class="w-full h-full object-cover block"
              />
              <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end">
                <p class="text-white text-xs p-2 w-full">{image.caption}</p>
              </div>
            </button>
          ))}
        </div>
      </section>

      <Footer />
    </main>
    <Lightbox images={homeStrip} />

    <style>
      /* Rotator wraps the quote text in <p>; strip default margin so it behaves
         like inline serif display type inside the h1. */
      #quote p { margin: 0; }
    </style>
  </body>
</html>
