---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Comments from '../components/Comments.astro'

const title = "404";
const description = "Page not found - Sorry, the page you are looking for does not exist. Explore other content on Trevor Lauder's site, including blog posts on DevOps, coding, automation, and photography.";
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <script src="../scripts/404-taunts.ts"></script>
  </head>
  <body class="min-h-screen">
    <Header />
    <main id="main" class="max-w-[1040px] mx-auto px-6 md:px-12 pt-[72px] pb-24">
      <section class="pb-10 border-b border-[var(--border-subtle)] mb-12">
        <span class="block font-mono text-xs uppercase tracking-[0.08em] text-[var(--accent)] mb-4">404 · Not Found</span>
        <h1 class="font-serif font-normal text-[clamp(64px,9vw,96px)] leading-[0.95] tracking-[-0.035em] text-[var(--text-primary)] m-0 mb-6 text-balance">
          This page isn't here.
        </h1>
        <div id="four-o-four-random-taunt" class="text-[20px] leading-[1.5] text-[var(--text-secondary)] max-w-[52ch] min-h-[1.5em]"></div>
        <div class="mt-8 flex items-center gap-6 font-mono text-[13px]">
          <a href="/" class="text-[var(--accent)] hover:underline">← Home</a>
          <a href="/blog/page/1" class="text-[var(--text-secondary)] hover:text-[var(--accent)]">Writing</a>
          <a href="/photography" class="text-[var(--text-secondary)] hover:text-[var(--accent)]">Photography</a>
        </div>
      </section>
      <div class="prose prose-article max-w-none text-[var(--text-primary)]">
        <Comments/>
      </div>
      <Footer />
    </main>
    <style>
      /* Rotator wraps output in <p>; strip its default margin */
      #four-o-four-random-taunt p { margin: 0; }
    </style>
  </body>
</html>
