---

import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import errorImage from "../assets/404-terminal.svg";
import Comments from '../components/Comments.astro'

const title = "404";
const description = "Page not found - Sorry, the page you are looking for does not exist. Explore other content on Trevor Lauder's site, including blog posts on DevOps, coding, automation, and photography.";

const heroImage = errorImage;
const heroImageWidth = 300;
const heroImageHeight = 150;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <script src="../scripts/404-taunts.ts"></script>
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-grow max-w-6xl mx-auto w-full px-4 md:px-6 py-8 md:py-12">
      <div>
        {
          heroImage && (
            <div class="mb-8 rounded-lg overflow-hidden">
              <Image
                src={heroImage}
                width={heroImageWidth}
                height={heroImageHeight}
                alt="404 Error"
                class="w-full h-auto"
              />
            </div>
          )
        }
        <h3 id="four-o-four-random-taunt" class="text-xl md:text-2xl font-bold text-gray-900 dark:text-slate-50 mb-8 text-center"></h3>
        <div class="prose dark:prose-invert max-w-none">
          <Comments/>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
