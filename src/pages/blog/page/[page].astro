---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import PostGrid from '../../../components/PostGrid.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';
import { getBlogStaticPaths, type BlogPageProps } from '../../../utils/blog';
import { getCollection } from 'astro:content';
import { normalizeSlug } from '../../../utils/blog';

export const getStaticPaths = getBlogStaticPaths;
type Props = BlogPageProps;

const { posts, currentPage, totalPages } = Astro.props;

// Build the category filter row from ALL posts (not just this page), so chips
// don't appear/disappear when paginating.
const all = await getCollection('blog');
const categories = Array.from(
	new Set(all.flatMap((p) => p.data.categories ?? []))
).sort();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="min-h-screen">
		<Header />
		<main id="main" class="max-w-7xl mx-auto px-6 md:px-12 pt-[72px] pb-24">
			<header class="pb-10 border-b border-[var(--border-subtle)] mb-8">
				<h1 class="font-serif font-normal text-[clamp(40px,5.4vw,56px)] leading-[1.05] tracking-[-0.025em] text-[var(--text-primary)] m-0 text-balance">
					Writing
				</h1>
			</header>

			{categories.length > 0 && (
				<nav aria-label="Filter by category" class="flex flex-wrap gap-2 mb-8 pb-6 border-b border-[var(--border-subtle)]">
					<a
						href="/blog/page/1"
						class="text-[12px] py-1.5 px-3 rounded-full border transition-colors bg-[var(--text-primary)] text-[var(--background)] border-[var(--text-primary)]"
					>All</a>
					{categories.map((c) => (
						<a
							href={`/categories/${normalizeSlug(c)}/`}
							class="text-[12px] py-1.5 px-3 rounded-full border transition-colors border-[var(--border-subtle)] text-[var(--text-secondary)] bg-[var(--surface)] hover:border-[var(--text-secondary)] hover:text-[var(--text-primary)]"
						>{c}</a>
					))}
				</nav>
			)}

			<PostGrid posts={posts} groupByYear={true} emptyMessage="No posts yet." />

			{totalPages > 1 && (
				<section class="pt-10 mt-2">
					<div class="flex items-center justify-between">
						{currentPage > 1 ? (
							<a
								href={`/blog/page/${currentPage - 1}`}
								class="font-mono text-[13px] text-[var(--text-secondary)] hover:text-[var(--accent)] no-underline"
							>
								← Previous
							</a>
						) : <span></span>}
						<span class="font-mono text-[12px] uppercase tracking-[0.08em] text-[var(--text-muted)]">
							Page {currentPage} / {totalPages}
						</span>
						{currentPage < totalPages ? (
							<a
								href={`/blog/page/${currentPage + 1}`}
								class="font-mono text-[13px] text-[var(--text-secondary)] hover:text-[var(--accent)] no-underline"
							>
								Next →
							</a>
						) : <span></span>}
					</div>
				</section>
			)}
			<Footer />
		</main>
	</body>
</html>
