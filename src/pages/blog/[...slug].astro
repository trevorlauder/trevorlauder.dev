---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => {
		// Extract date and slug from post.id (format: YYYY-MM-DD-slug-with-dashes)
		const dateMatch = post.id.match(/^(\d{4})-(\d{2})-(\d{2})-(.+)$/);
		let slug = post.id;
		let year = '';
		let month = '';
		let day = '';

		if (dateMatch && dateMatch.length >= 5) {
			year = dateMatch[1] || '';
			month = dateMatch[2] || '';
			day = dateMatch[3] || '';
			slug = (dateMatch[4] || '').toLowerCase();
		}

		const pubDate = post.data.pubDate ?? (year && month && day
			? new Date(parseInt(year), parseInt(month) - 1, parseInt(day))
			: undefined);

		return {
			params: { slug: `${year}/${month}/${day}/${slug}` },
			props: { ...post, data: { ...post.data, pubDate } },
		};
	});
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} Content={Content} />
