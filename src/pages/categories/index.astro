---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import { normalizeSlug } from "../../utils/blog";

const allPosts = await getCollection("blog");
const counts = new Map<string, number>();
for (const post of allPosts) {
  for (const cat of post.data.categories ?? []) {
    counts.set(cat, (counts.get(cat) ?? 0) + 1);
  }
}
const cats = Array.from(counts.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<html lang="en">
  <head>
    <BaseHead title="Categories" description={SITE_DESCRIPTION} />
  </head>
  <body class="min-h-screen">
    <Header />
    <main id="main" class="max-w-[1200px] mx-auto px-6 md:px-12 pt-[72px] pb-24">
      <header class="pb-10 border-b border-[var(--border-subtle)] mb-10">
        <h1 class="font-serif font-normal text-[clamp(40px,5.4vw,56px)] leading-[1.05] tracking-[-0.025em] text-[var(--text-primary)] m-0 text-balance">
          Categories
        </h1>
        <p class="text-[var(--text-secondary)] mt-4 text-[15px]">{cats.length} categories across {allPosts.length} posts.</p>
      </header>
      <section class="flex flex-col">
        {cats.map(([cat, count]) => (
          <a
            href={`/categories/${normalizeSlug(cat)}/`}
            class="group grid grid-cols-[1fr_auto] items-baseline gap-5 py-4 border-b border-[var(--border-faint)] no-underline transition-[padding] duration-200 hover:pl-1.5"
          >
            <span class="font-serif text-[22px] font-normal tracking-[-0.01em] text-[var(--text-primary)] transition-colors group-hover:text-[var(--accent)]">{cat}</span>
            <span class="font-mono text-[12px] uppercase tracking-[0.08em] text-[var(--text-muted)]">{count} {count === 1 ? 'post' : 'posts'}</span>
          </a>
        ))}
      </section>
      <Footer />
    </main>
  </body>
</html>
