---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostGrid from '../../components/PostGrid.astro';
import { SITE_TITLE } from '../../consts';
import {
	enrichPostsWithDates,
	normalizeLabel,
	normalizeSlug,
	sortPostsByDate,
} from '../../utils/blog';

export async function getStaticPaths() {
	const posts = await getCollection('blog');

	// Extract all unique categories
	const categories = new Set<string>();
	posts.forEach((post) => {
		if (post.data.categories && Array.isArray(post.data.categories)) {
			post.data.categories.forEach((category) => {
				categories.add(normalizeSlug(category));
			});
		}
	});

	return Array.from(categories).map((category) => ({
		params: { category },
		props: { category },
	}));
}

interface Props {
	category: string;
}

const { category } = Astro.props;
const posts = await getCollection('blog');

// Filter posts by category
const categoryLabel = normalizeLabel(category);
const filteredPosts = sortPostsByDate(
	enrichPostsWithDates(
		posts.filter((post) =>
			post.data.categories?.some((c) => normalizeSlug(c) === category)
		)
	)
).filter((post) => post.data.pubDate);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${categoryLabel} | ${SITE_TITLE}`}
			description={`Blog posts in the ${categoryLabel} category`}
		/>
	</head>
	<body class="flex flex-col min-h-screen">
		<Header />
		<main class="flex-grow max-w-6xl mx-auto w-full px-4 md:px-6 py-8 md:py-12">
			<section>
				<h1
					class="text-3xl md:text-4xl font-bold mb-12 text-[var(--text-primary)] text-center"
				>
					{categoryLabel}
				</h1>
				<hr class="border-t border-[var(--border)] mb-12" />
				<PostGrid
					posts={filteredPosts}
					emptyMessage="No posts found in this category."
				/>
				<div class="mt-8 text-center">
					<a
						href="/categories"
						class="inline-block px-4 py-2 bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-white rounded-lg transition-colors"
					>
						← Back to Categories
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
