---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import PostGrid from "../../components/PostGrid.astro";
import { SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import {
  enrichPostsWithDates,
  normalizeSlug,
  sortPostsByDate,
} from "../../utils/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const bySlug = new Map<string, { tag: string; posts: typeof posts }>();
  for (const post of posts) {
    for (const tag of post.data.tags ?? []) {
      const slug = normalizeSlug(tag);
      if (!bySlug.has(slug)) bySlug.set(slug, { tag, posts: [] });
      bySlug.get(slug)!.posts.push(post);
    }
  }
  return Array.from(bySlug.entries()).map(([slug, { tag, posts }]) => ({
    params: { tag: slug },
    props: { tag, posts },
  }));
}

const { tag, posts } = Astro.props;
const sorted = sortPostsByDate(enrichPostsWithDates(posts));
---

<html lang="en">
  <head>
    <BaseHead title={`#${tag}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="min-h-screen">
    <Header />
    <main id="main" class="max-w-[1080px] mx-auto px-6 md:px-12 pt-[72px] pb-24">
      <header class="pb-10 border-b border-[var(--border-subtle)] mb-10">
        <a href="/tags/" class="inline-flex items-center gap-1.5 text-[13px] text-[var(--text-secondary)] no-underline hover:text-[var(--accent)] mb-6">← All tags</a>
        <span class="block text-xs font-medium uppercase tracking-[0.08em] text-[var(--text-muted)] mb-4">Tag</span>
        <h1 class="font-serif font-normal text-[clamp(40px,5.4vw,56px)] leading-[1.05] tracking-[-0.025em] text-[var(--text-primary)] m-0 text-balance">
          #{tag}
        </h1>
        <p class="text-[var(--text-secondary)] mt-4 text-[15px]">{sorted.length} {sorted.length === 1 ? 'post' : 'posts'}.</p>
      </header>
      <PostGrid posts={sorted} emptyMessage="No posts yet." />
      <Footer />
    </main>
  </body>
</html>
