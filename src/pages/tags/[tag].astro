---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostGrid from '../../components/PostGrid.astro';
import { SITE_TITLE } from '../../consts';
import {
	enrichPostsWithDates,
	normalizeLabel,
	normalizeSlug,
	sortPostsByDate,
} from '../../utils/blog';

export async function getStaticPaths() {
	const posts = await getCollection('blog');

	// Extract all unique tags
	const tags = new Set<string>();
	posts.forEach((post) => {
		if (post.data.tags && Array.isArray(post.data.tags)) {
			post.data.tags.forEach((tag) => {
				tags.add(normalizeSlug(tag));
			});
		}
	});

	return Array.from(tags).map((tag) => ({
		params: { tag },
		props: { tag },
	}));
}

interface Props {
	tag: string;
}

const { tag } = Astro.props;
const posts = await getCollection('blog');

// Filter posts by tag
const tagLabel = normalizeLabel(tag);
const filteredPosts = sortPostsByDate(
	enrichPostsWithDates(
		posts.filter((post) =>
			post.data.tags?.some((t) => normalizeSlug(t) === tag)
		)
	)
).filter((post) => post.data.pubDate);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${tagLabel} | ${SITE_TITLE}`}
			description={`Blog posts tagged with ${tagLabel}`}
		/>
	</head>
	<body class="flex flex-col min-h-screen">
		<Header />
		<main class="flex-grow max-w-6xl mx-auto w-full px-4 md:px-6 py-8 md:py-12">
			<section>
				<h1
					class="text-3xl md:text-4xl font-bold mb-12 text-[var(--text-primary)] text-center"
				>
					{tagLabel}
				</h1>
				<hr class="border-t border-[var(--border)] mb-12" />
				<PostGrid
					posts={filteredPosts}
					emptyMessage="No posts found with this tag."
				/>
				<div class="mt-8 text-center">
					<a
						href="/tags"
						class="inline-block px-4 py-2 bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-white rounded-lg transition-colors"
					>
						← Back to Tags
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
