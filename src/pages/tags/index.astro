---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import { normalizeSlug } from "../../utils/blog";

const allPosts = await getCollection("blog");
const counts = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags ?? []) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = Array.from(counts.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const max = Math.max(1, ...tags.map(([, n]) => n));
---

<html lang="en">
  <head>
    <BaseHead title="Tags" description={SITE_DESCRIPTION} />
  </head>
  <body class="min-h-screen">
    <Header />
    <main id="main" class="max-w-7xl mx-auto px-6 md:px-12 pt-[72px] pb-24">
      <header class="pb-10 border-b border-[var(--border-subtle)] mb-10">
        <h1 class="font-serif font-normal text-[clamp(40px,5.4vw,56px)] leading-[1.05] tracking-[-0.025em] text-[var(--text-primary)] m-0 text-balance">
          Tags
        </h1>
        <p class="text-[var(--text-secondary)] mt-4 text-[15px]">{tags.length} tags across {allPosts.length} posts.</p>
      </header>
      <section class="flex flex-wrap gap-2">
        {tags.map(([tag, count]) => {
          const ratio = count / max;
          return (
            <a
              href={`/tags/${normalizeSlug(tag)}/`}
              class="inline-flex items-baseline gap-2 py-1.5 px-3 border border-[var(--border-subtle)] rounded-full bg-[var(--surface)] text-[var(--text-primary)] no-underline hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
              style={`font-size: ${13 + ratio * 6}px;`}
            >
              <span>{tag}</span>
              <span class="font-mono text-[11px] text-[var(--text-muted)]">{count}</span>
            </a>
          );
        })}
      </section>
      <Footer />
    </main>
  </body>
</html>
