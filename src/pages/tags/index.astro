---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');

// Extract and count all tags
const tagCounts: Record<string, number> = {};
posts.forEach((post) => {
	if (post.data.tags && Array.isArray(post.data.tags)) {
		post.data.tags.forEach((tag) => {
			tagCounts[tag] = (tagCounts[tag] || 0) + 1;
		});
	}
});

// Sort tags alphabetically
const sortedTags = Object.entries(tagCounts).sort(([a], [b]) => a.localeCompare(b));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tags | ${SITE_TITLE}`} description={`Browse blog posts by tags on ${SITE_TITLE}`} />
	</head>
	<body class="flex flex-col min-h-screen">
		<Header />
		<main class="flex-grow max-w-6xl mx-auto w-full px-4 md:px-6 py-8 md:py-12">
			<section>
			<h1 class="text-3xl md:text-4xl font-bold mb-12 text-gray-900 dark:text-slate-50 text-center">
				Tags
			</h1>
			<hr class="border-t border-[var(--border)] mb-12" />				{sortedTags.length === 0 ? (
					<p class="text-center text-gray-600 dark:text-slate-400">No tags found.</p>
				) : (
					<div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
						{sortedTags.map(([tag, count]) => (
							<div class="group">
								<a
									href={`/tags/${encodeURIComponent(tag.toLowerCase().replace(/\s+/g, '-'))}/`}
									class="card-hover flex flex-col items-center justify-center p-8 md:p-10 rounded-lg border border-[var(--border)] bg-white dark:bg-[var(--surface-secondary)] hover:border-gray-300 dark:hover:border-[var(--border-hover)] hover:shadow-lg dark:hover:shadow-xl transition-all duration-300 h-40"
								>
									<h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-slate-50 mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors text-center">
										{tag}
									</h2>
									<span class="inline-block px-4 py-2 bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-100 text-sm font-semibold rounded-full">
										{count} {count === 1 ? 'post' : 'posts'}
									</span>
								</a>
							</div>
						))}
					</div>
				)}
			</section>
		</main>
		<Footer />
	</body>
</html>
