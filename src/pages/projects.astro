---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

const projects = [
  {
    name: "Dev Container Features",
    description:
      "My personal Dev Container Features that integrate with my dotfiles toolchain.",
    tech: ["Shell", "Dev Containers"],
    year: "Since 2026",
    url: "https://github.com/trevorlauder/devcontainers",
  },
  {
    name: "Cloudflare DoH Worker",
    description:
      "Fans out DNS over HTTPS queries to multiple providers in parallel and returns the most restrictive result.",
    tech: ["Python", "Cloudflare Workers"],
    year: "Since 2021",
    url: "https://github.com/trevorlauder/cloudflare-doh-worker",
  },
];

const title = "Projects";
const description =
  "Open source tools and personal projects by Trevor Lauder, including DNS over HTTPS infrastructure, and other tinkering.";
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="min-h-screen">
    <Header />
    <main id="main" class="max-w-[1040px] mx-auto px-6 md:px-12 pt-[72px] pb-24">
      <section class="pb-10 border-b border-[var(--border-subtle)] mb-10">
        <h1 class="font-serif font-normal text-[clamp(36px,4.8vw,52px)] leading-[1.05] tracking-[-0.025em] text-[var(--text-primary)] m-0 mb-3 text-balance">
          Projects
        </h1>
        <p class="text-[var(--text-secondary)] text-[15px] leading-[1.6] max-w-[62ch] m-0">
          Things I build to automate, observe, or generally over-engineer at home.
        </p>
      </section>

      <section>
        <ul class="list-none p-0 m-0 flex flex-col">
          {
            projects.map((project) => (
              <li>
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group grid grid-cols-[100px_1fr] md:grid-cols-[120px_1fr_auto] gap-5 md:gap-7 items-baseline py-6 border-b border-[var(--border-faint)] last:border-b-0 no-underline transition-[padding] duration-200 hover:pl-1.5"
                >
                  <span class="font-mono text-[12px] text-[var(--text-muted)] tabular-nums whitespace-nowrap pt-1">
                    {project.year}
                  </span>
                  <div>
                    <h2 class="font-serif text-[22px] font-normal tracking-[-0.01em] text-[var(--text-primary)] leading-[1.3] m-0 transition-colors group-hover:text-[var(--accent)]">
                      {project.name}
                    </h2>
                    <p class="text-[15px] text-[var(--text-secondary)] leading-[1.55] mt-1.5 mb-3 max-w-[62ch]">
                      {project.description}
                    </p>
                    <div class="flex flex-wrap gap-1.5">
                      {project.tech.map((t) => (
                        <span class="font-mono text-[11px] py-0.5 px-2 border border-[var(--border-subtle)] rounded-full text-[var(--text-muted)] bg-[var(--surface)]">
                          {t}
                        </span>
                      ))}
                    </div>
                  </div>
                  <span class="hidden md:inline text-[var(--text-muted)] group-hover:text-[var(--accent)] transition-colors pt-1" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <Footer />
    </main>
  </body>
</html>
